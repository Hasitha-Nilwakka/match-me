{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0",
    "dev:mobile": "cross-env NEXT_DEV_OVERLAY=false next dev --turbopack --hostname 0.0.0.0",
    "dev:clean": "cross-env NEXT_DEV_OVERLAY=false next dev --turbopack --hostname 0.0.0.0",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "db:studio": "prisma studio",
    "db:pull": "prisma db pull && node fix-schema.js",
    "db:seed": "cd ../backend && go run ./seeders/user_seeder.go"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "emoji-picker-react": "^4.14.0",
    "next": "15.5.2",
    "postcss": "^8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
